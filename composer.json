{
    "name": "byteminus/laravel-bdpaygate",
    "description": "Every Bangladeshi payment gateway behind one Laravel API: bKash, Nagad, SSLCommerz, Upay, ShurjoPay, aamarPay, PortPos, PayStation, UddoktaPay, Moneybag, EPS, DGePay. Every callback verified server-to-server.",
    "keywords": [
        "laravel",
        "bangladesh",
        "payment",
        "payment-gateway",
        "bkash",
        "nagad",
        "sslcommerz",
        "upay",
        "rocket",
        "shurjopay",
        "aamarpay",
        "portpos",
        "portwallet",
        "paystation",
        "uddoktapay",
        "moneybag",
        "eps",
        "dgepay",
        "bdt",
        "bdpaygate"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://bdpaygate.github.io",
    "authors": [
        {
            "name": "Mr Hawk",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/byteminus/laravel-bdpaygate/issues",
        "source": "https://github.com/byteminus/laravel-bdpaygate",
        "docs": "https://bdpaygate.github.io"
    },
    "require": {
        "php": "^8.2",
        "ext-openssl": "*",
        "illuminate/cache": "^11.0|^12.0|^13.0",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "ByteMinus\\BdPayGate\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ByteMinus\\BdPayGate\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint",
        "check": [
            "@format",
            "@analyse",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "ByteMinus\\BdPayGate\\BdPayGateServiceProvider"
            ],
            "aliases": {
                "BdPayGate": "ByteMinus\\BdPayGate\\Facades\\BdPayGate"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
